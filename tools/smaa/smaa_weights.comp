#version 450
#extension GL_GOOGLE_include_directive : require
// SMAA pass 2: blending weights from the edges' shapes (the area and search lookup textures).
#include "smaa_common.glsl"

layout(set = 0, binding = 0) uniform sampler2D edges_tex;   // linear
layout(set = 0, binding = 1) uniform sampler2D area_tex;    // linear
layout(set = 0, binding = 2) uniform sampler2D search_tex;  // point
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D blend_out;

void main() {
  ivec2 pixel;
  vec2 texcoord;
  if (!Mp3SmaaPixel(pixel, texcoord)) return;
  vec2 pixcoord;
  vec4 offset[3];
  SMAABlendingWeightCalculationVS(texcoord, pixcoord, offset);
  imageStore(blend_out, pixel,
             SMAABlendingWeightCalculationPS(texcoord, pixcoord, offset, edges_tex, area_tex,
                                             search_tex, vec4(0.0)));
}
