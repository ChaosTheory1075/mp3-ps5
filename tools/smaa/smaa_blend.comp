#version 450
#extension GL_GOOGLE_include_directive : require
// SMAA pass 3: each edge pixel blended with its neighbour, into the presenter's guest output.
#include "smaa_common.glsl"

layout(set = 0, binding = 0) uniform sampler2D color_tex;  // linear
layout(set = 0, binding = 1) uniform sampler2D blend_tex;  // linear
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D color_out;

void main() {
  ivec2 pixel;
  vec2 texcoord;
  if (!Mp3SmaaPixel(pixel, texcoord)) return;
  vec4 offset;
  SMAANeighborhoodBlendingVS(texcoord, offset);
  imageStore(color_out, pixel,
             vec4(SMAANeighborhoodBlendingPS(texcoord, offset, color_tex, blend_tex).rgb, 1.0));
}
